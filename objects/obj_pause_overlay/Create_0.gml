/// obj_pause_overlay Create Event

// Imposta depth molto basso per essere sopra a tutto
depth = -10000;

// Testo e posizioni
text_paused = "PAUSED";
text_resume = "TAP TO RESUME";

cont_offset = 2;

y_paused = room_height / 3;
y_resume = room_height / 2 + 100;

// Animazione pulsante per "TAP TO RESUME"
pulse_alpha = 0;
pulse_speed = 0.05;